# Public origin of the stable deployment. Do not use a changing Preview URL for OAuth.
APP_URL=http://localhost:3000
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/threads/callback

# Meta App Dashboard > App settings > Basic.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Neon Postgres connection string injected by Vercel Marketplace.
DATABASE_URL=

# Generate independently: openssl rand -base64 32
APP_ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=

# Optional comma-separated Threads user IDs. Leave empty to rely on Meta App roles/review.
THREADS_ALLOWED_USER_IDS=

# Bounded serverless sync settings.
SYNC_POST_LIMIT=100
SYNC_CONNECTION_LIMIT=5
DATA_RETENTION_DAYS=90
